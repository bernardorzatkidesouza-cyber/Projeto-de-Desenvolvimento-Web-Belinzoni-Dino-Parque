# Banco PostgreSQL (Neon ou local)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?sslmode=require

# Porta da API
PORT=3001

# Chave usada para assinar os tokens de login (use uma chave longa e aleatoria)
JWT_SECRET=COLOQUE_UMA_CHAVE_LONGA_E_ALEATORIA_AQUI

# Dados do primeiro administrador master (criado automaticamente se nao existir admin)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque_esta_senha
